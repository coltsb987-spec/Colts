# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public values: safe in the browser because every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or the legacy "anon" key. NOT the secret/service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The address your app is served from. Used for links in confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stage 1 does not need the secret (service_role) key. When a later stage does, add it
# here WITHOUT the NEXT_PUBLIC_ prefix so it never reaches the browser:
# SUPABASE_SECRET_KEY=

# Only for running the database tests against a local Postgres (see README).
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/postgres
