# Copy this file to .env (same folder) and fill in. .env is git-ignored. Never share it.

# Your Invo refresh token (see README "Step 2"). Lasts about a year.
INVO_REFRESH_TOKEN=

# Anthropic API key for the explanations (https://console.anthropic.com -> API keys).
# Leave blank to run without AI explanations (alerts then say "reason: not analysed").
ANTHROPIC_API_KEY=

# Telegram (simplest alert channel). See README "Step 4".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email instead of Telegram (only if alert_channel is "email" in config.json)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
