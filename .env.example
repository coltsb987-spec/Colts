# Copy this file to ".env" (same folder) and fill in values ONLY if you set up
# the optional Instagram Graph API research feature. ".env" is git-ignored,
# so your token is never committed. Never paste tokens into chat or other files.

# Your own Instagram Professional (Business/Creator) account ID, from Meta's Graph API Explorer
IG_USER_ID=
# A long-lived user access token with instagram_basic + pages_show_list permissions
IG_ACCESS_TOKEN=
