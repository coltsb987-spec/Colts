# Copy this file to .env.local and fill in the values (never commit .env.local).
# Find these in Supabase: Project Settings -> API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The public address of the site (used in sign-in emails). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
