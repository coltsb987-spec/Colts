# Copy this file to .env.local and fill in the values (never commit .env.local).

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses row-level security – never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The public address of the site (emails and Stripe redirects). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Developers -> API keys). Use sk_test_ until you go live. ---
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secrets (Developers -> Webhooks -> your endpoint -> Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx            # endpoint listening to "Your account"
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx    # endpoint listening to "Connected accounts"
# Optional
PLATFORM_FEE_PERCENT=0          # CoachBook's cut of each booking (0 during the pilot)
SUBSCRIPTION_TRIAL_DAYS=60      # free trial when a coach starts the £40/month plan

# --- Daily reminder emails (Vercel Cron sends this automatically) ---
CRON_SECRET=any-long-random-string

# --- Email via Resend (optional until launch; emails are skipped without it) ---
RESEND_API_KEY=
EMAIL_FROM=CoachBook UK <bookings@mycoachbook.co.uk>

# --- AI receptionist (Phase 3) ---
# Claude API key from https://platform.claude.com (Settings -> API keys). Server-only.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5) and spending guards
RECEPTIONIST_MODEL=
RECEPTIONIST_MAX_MESSAGES_PER_CHAT=30
RECEPTIONIST_MAX_CHATS_PER_IP_HOUR=10
RECEPTIONIST_MAX_MESSAGES_PER_COACH_DAY=300
# Optional: where replies to CoachBook emails go when there's no coach to reply to
EMAIL_REPLY_TO=

# --- "Fill my profile for me" (Phase 3b) – uses ANTHROPIC_API_KEY ---
# Optional: model (defaults to RECEPTIONIST_MODEL, then claude-opus-5-5) and daily drafts per coach
SETUP_ASSISTANT_MODEL=
SETUP_ASSISTANT_DRAFTS_PER_DAY=10
